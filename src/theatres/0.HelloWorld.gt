{
	AmbientLightingColor (1.0, 1.0, 1.0)
	AmbientLightingStrength (0.2)
}
LightDirectional (Sun)
{
	Direction (-0.2, -1.0, -0.3)
	Strength  (0.2)
	Color     (0.8, 0.9, 1.0)
}
