Some psuedo-code ideas:
:::C++
Actor (Test)
{
	Mesh:Material <Cube>:<DoomMat>
}


#define THEATRE_REFERENCE 0
#define RAW_DATA 1

{{"Actor", {RAW_DATA, "Test"}}, {"Actor:Mesh", {THEATRE_REFERENCE, "Cube"}}, {"Actor:Mesh:Material", {THEATRE_REFERENCE, "DoomMat"}}}

gSettings mesh_settings = {{"Name", "Cube"}, {"Material", new_theatre.getDevice(material_uid)}}

{"Mesh", {devices_map[MESH], mesh_settings}}

variable = new Mesh(mesh_settings)

Mesh::Mesh(gSettings new_settings)
{
	loadSettings(new_settings);
}

// Or...

Actor::loadSettings(gSettings new_settings)
{
	getSetting(mesh, new_settings["Mesh"]);
	getSetting(mesh->material, new_settings["Mesh:Material"]);
}
:::


The idea is to treat sandwiches the same as theatre references, but I think that it might need to be tweaked.

New Idea: sandwiches are different from theatre references, but are basically just like a nested gSettings with an assigned class type (since sandwiches always result in needing to make a new class anyways). This would also allow for sandwiches to accept any data types.

:::C++
// In graphx_namespace.hpp
// ...
typedef std::pair<Actor *, gSettings> gActorSandwich;
typedef std::pair<Device *, gSettings> gDeviceSandwich;
// ...

// In t_settings.hpp
// ...
else if constexpr(std::is_base_of_v<Device, std::remove_pointer_t<T>>)
{
	if(set_value.type() == typeid(gDeviceSandwich))
	{
		variable = static_cast<T>(std::any_cast<gDeviceSandwich>(set_value.first));
		dynamic_cast<Device *>(&variable)->loadSettings(std::any_cast<gDeviceSandwich>(set_value.second));
	}

	else if(set_value.type() == typeid(Device *))
	{
		variable = static_cast<T>(std::any_cast<Device *>(set_value.first));
	}

	else
	{
		PRINTERR(GRAB_SETTING_ERR_MSG_TEMPLATE << "\n\tSetting type: " << set_value.type().name() << " (unknown)\n\tVariable type: " << typeid(variable).name())
		return GRAB_SETTING_ERR_DEVICE_POINTER;
	}

	return 0;
}
// same idea for Actors
// ...
