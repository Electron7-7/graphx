else if constexpr(std::is_base_of_v<Device, std::remove_pointer_t<T>>)
{
    if(set_value.type() == typeid(gDeviceSandwich))
    {
        variable = static_cast<T>(std::any_cast<gDeviceSandwich>(set_value.first));
        dynamic_cast<Device *>(&variable)->loadSettings(std::any_cast<gDeviceSandwich>(set_value.second));
    }

    else if(set_value.type() == typeid(Device *))
    {
        variable = static_cast<T>(std::any_cast<Device *>(set_value.first));
    }

    else
    {
        PRINTERR(GRAB_SETTING_ERR_MSG_TEMPLATE << "\n\tSetting type: " << set_value.type().name() << " (unknown)\n\tVariable type: " << typeid(variable).name())
