Man, all these header files are giving me headaches. Specifically knowing where and when certain ones get included first. I think I'm going to make a small .cpp file that just includes every header file and make that the first file that gets compiled. That way, if I make changes to any header files, I know which .cpp file to recompile!

For later: try this example from DeepSeek:
----- BEGIN DEEPSEEK OUTPUT -----
CXX := g++
CXXFLAGS := -MMD -MP -std=c++17 -Wall

SRC := $(wildcard *.cpp)
OBJ := $(SRC:.cpp=.o)
DEP := $(OBJ:.o=.d)

EXEC := my_program

.PHONY: all clean

all: $(EXEC)

$(EXEC): main.o $(OBJ)
    $(CXX) $(CXXFLAGS) $^ -o $@

%.o: %.cpp
    $(CXX) $(CXXFLAGS) -c $< -o $@

-include $(DEP)

clean:
    rm -f $(OBJ) $(DEP) $(EXEC)
----- END DEEPSEEK OUTPUT -----

